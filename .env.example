# ========================================
# LiveKit Agent V3 - Configuração
# ========================================
# Copie este arquivo para .env e preencha
# ========================================

# LiveKit Server
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=sua_api_key_aqui
LIVEKIT_API_SECRET=sua_secret_aqui

# OpenAI (para LLM e TTS)
OPENAI_API_KEY=sua_openai_key_aqui

# Deepgram (para STT em português)
DEEPGRAM_API_KEY=sua_deepgram_key_aqui
